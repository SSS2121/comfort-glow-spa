{
  "name": "d3-glow-spa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "images:build": "node scripts/optimize-images.mjs",
    "seo:build": "node scripts/generate-discovery.mjs",
    "build": "npm run images:build && npm run seo:build && vite build",
    "preview": "vite preview",
